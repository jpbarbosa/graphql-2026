# Copy to .env (gitignored) and fill in the user and password of your Postgres.
# On this machine that is shared-postgres from ~/Sites/services, reached over the `services` network.
DATABASE_URL=postgres://USER:PASSWORD@shared-postgres:5432/graphql_2026
# A role allowed to CREATE DATABASE, used only on first boot to create graphql_2026.
ADMIN_DATABASE_URL=postgres://USER:PASSWORD@shared-postgres:5432/postgres
